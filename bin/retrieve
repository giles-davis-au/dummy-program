#!/usr/bin/env python3
"""Local text search over the durable wiki: matches entity-index.json aliases first,
then falls back to a case-insensitive substring search over page bodies. No vector
database, no external service — plain file search, per the blueprint's guidance that
this is sufficient at this scale.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _wikilib as W  # noqa: E402


def main():
    if len(sys.argv) < 2:
        print("usage: bin/retrieve <query>")
        sys.exit(2)
    query = " ".join(sys.argv[1:]).lower()

    entity_path = os.path.join(W.WIKI_ROOT, "entity-index.json")
    matched_vault_paths = set()
    if os.path.exists(entity_path):
        with open(entity_path, encoding="utf-8") as f:
            entity_index = json.load(f)
        for alias, vault_path in entity_index.items():
            if query in alias.lower():
                matched_vault_paths.add(vault_path)
                print(f"[entity: {alias}] wiki/{vault_path}")

    for path in W.durable_pages():
        if W.vault_rel(path) in matched_vault_paths:
            continue
        _, body = W.parse_page(path)
        lower = body.lower()
        if query in lower:
            idx = lower.find(query)
            snippet = body[max(0, idx - 40):idx + 60].replace("\n", " ")
            print(f"[text match] {W.repo_rel(path)}: ...{snippet}...")


if __name__ == "__main__":
    main()
